<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Build requirements:
      * A Valheim install with BepInEx 5 already set up.
      * The game path, in order of precedence:
          - ValheimPath property in Local.props next to this file (git-ignored), e.g.
              <Project><PropertyGroup>
                <ValheimPath>D:\Steam\steamapps\common\Valheim</ValheimPath>
              </PropertyGroup></Project>
          - VALHEIM_INSTALL environment variable
          - default Steam location on Windows
      * Set CopyToGame=true (Local.props or -p:CopyToGame=true) to copy the build into
        BepInEx/plugins/AdvancedPlanting after every build.
    Game and Unity assemblies are referenced straight from the install so the mod always
    compiles against the exact version you play. Private members of assembly_valheim are
    exposed through BepInEx.AssemblyPublicizer at build time.
  -->

  <Import Project="Local.props" Condition="Exists('Local.props')" />

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>AdvancedPlanting</AssemblyName>
    <RootNamespace>AdvancedPlanting</RootNamespace>
    <Version>0.4.6</Version>
    <Authors>kepqa</Authors>
    <Company>kepqa</Company>
    <Copyright>Copyright (c) 2026 kepqa</Copyright>
    <Deterministic>true</Deterministic>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <PropertyGroup>
    <ValheimPath Condition="'$(ValheimPath)' == ''">$(VALHEIM_INSTALL)</ValheimPath>
    <ValheimPath Condition="'$(ValheimPath)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Valheim</ValheimPath>
    <ManagedPath>$(ValheimPath)/valheim_Data/Managed</ManagedPath>
    <BepInExCorePath>$(ValheimPath)/BepInEx/core</BepInExCorePath>
    <PluginOutputPath>$(ValheimPath)/BepInEx/plugins/AdvancedPlanting</PluginOutputPath>
    <CopyToGame Condition="'$(CopyToGame)' == ''">false</CopyToGame>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BepInEx.AssemblyPublicizer.MSBuild" Version="0.4.3" PrivateAssets="all" />
    <!-- Lets the net472 target build on machines without .NET Framework installed (Linux, CI). -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="assembly_valheim" Publicize="true" Private="false">
      <HintPath>$(ManagedPath)/assembly_valheim.dll</HintPath>
    </Reference>
    <Reference Include="assembly_utils" Publicize="true" Private="false">
      <HintPath>$(ManagedPath)/assembly_utils.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine" Private="false">
      <HintPath>$(ManagedPath)/UnityEngine.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.CoreModule" Private="false">
      <HintPath>$(ManagedPath)/UnityEngine.CoreModule.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.PhysicsModule" Private="false">
      <HintPath>$(ManagedPath)/UnityEngine.PhysicsModule.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule" Private="false">
      <HintPath>$(ManagedPath)/UnityEngine.IMGUIModule.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule" Private="false">
      <HintPath>$(ManagedPath)/UnityEngine.TextRenderingModule.dll</HintPath>
    </Reference>
    <Reference Include="assembly_guiutils" Publicize="true" Private="false">
      <HintPath>$(ManagedPath)/assembly_guiutils.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.UI" Private="false">
      <HintPath>$(ManagedPath)/UnityEngine.UI.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.UIModule" Private="false">
      <HintPath>$(ManagedPath)/UnityEngine.UIModule.dll</HintPath>
    </Reference>
    <Reference Include="Unity.TextMeshPro" Private="false">
      <HintPath>$(ManagedPath)/Unity.TextMeshPro.dll</HintPath>
    </Reference>
    <Reference Include="BepInEx" Private="false">
      <HintPath>$(BepInExCorePath)/BepInEx.dll</HintPath>
    </Reference>
    <Reference Include="0Harmony" Private="false">
      <HintPath>$(BepInExCorePath)/0Harmony.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <!-- Built-in translations; copies next to the DLL let players edit or add languages. -->
    <EmbeddedResource Include="Translations/*.txt" LogicalName="AdvancedPlanting.Translations.%(Filename).txt" />
    <None Include="Translations/*.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../AdvancedPlanting.Core/AdvancedPlanting.Core.csproj" />
  </ItemGroup>

  <!--
    Thunderstore package, built with every Release build:
      dist/kepqa-AdvancedPlanting-<version>.zip
        manifest.json  (generated from the properties below)
        icon.png, README.md, CHANGELOG.md
        AdvancedPlanting.dll, AdvancedPlanting.Core.dll
        Translations/*.txt
    DLLs sit at the archive root, the layout r2modman and Thunderstore install straight into
    BepInEx/plugins/kepqa-AdvancedPlanting/ (a nested plugins/ folder was not picked up).
    Upload it at thunderstore.io under the team "kepqa".
  -->
  <PropertyGroup>
    <ThunderstoreName>AdvancedPlanting</ThunderstoreName>
    <ThunderstoreDescription>Plant along lines, arcs, circles, curves and filled shapes. Rows, jitter, live preview, vanilla costs.</ThunderstoreDescription>
    <ThunderstoreWebsite>https://github.com/Kepqa/AdvancedPlanting</ThunderstoreWebsite>
    <ThunderstoreDependency>denikson-BepInExPack_Valheim-5.4.2351</ThunderstoreDependency>
    <RepoRoot>$(MSBuildThisFileDirectory)../../</RepoRoot>
    <PackageStaging>$(RepoRoot)dist/package/</PackageStaging>
    <PackageZip>$(RepoRoot)dist/kepqa-$(ThunderstoreName)-$(Version).zip</PackageZip>
  </PropertyGroup>

  <!-- Thunderstore does not show relative images, so the packaged README links to hosted copies. -->
  <ItemGroup>
    <ReadmeImage Include="images/preview-1-planted-circle.jpg" Url="https://i.postimg.cc/SxfnpKTT/preview-1-planted-circle.jpg" />
    <ReadmeImage Include="images/preview-2-circle-hollow.jpg" Url="https://i.postimg.cc/W1wdP4YR/preview-2-circle-hollow.jpg" />
    <ReadmeImage Include="images/preview-3-curve.jpg" Url="https://i.postimg.cc/mgyPGrpW/preview-3-curve.jpg" />
    <ReadmeImage Include="images/preview-4-settings-window.jpg" Url="https://i.postimg.cc/Mpmn8G38/preview-4-settings-window.jpg" />
    <ReadmeImage Include="images/preview-5-two-curves.jpg" Url="https://i.postimg.cc/jS4Drj3T/preview-5-two-curves.jpg" />
    <ReadmeImage Include="images/preview-6-settings-wheel.jpg" Url="https://i.postimg.cc/mgyPGrpB/preview-6-settings-wheel.jpg" />
  </ItemGroup>

  <!-- Copies README.md without repo-only blocks and with each local image path swapped for its hosted URL. -->
  <UsingTask TaskName="PackageReadme" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)/Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <Source Required="true" />
      <Destination Required="true" />
      <Images ParameterType="Microsoft.Build.Framework.ITaskItem[]" Required="true" />
    </ParameterGroup>
    <Task>
      <Code Type="Fragment" Language="cs"><![CDATA[
        string text = System.IO.File.ReadAllText(Source);
        // Credits and other repository notes stay out of the mod page.
        text = System.Text.RegularExpressions.Regex.Replace(text, @"<!-- repo-only -->[\s\S]*?<!-- /repo-only -->\r?\n(\r?\n)?", "");
        foreach (var image in Images)
          text = text.Replace("](" + image.ItemSpec + ")", "](" + image.GetMetadata("Url") + ")");
        if (text.Contains("](images/"))
        {
          Log.LogError("README.md has an image without a hosted URL in ReadmeImage.");
          return false;
        }
        System.IO.Directory.CreateDirectory(System.IO.Path.GetDirectoryName(Destination));
        System.IO.File.WriteAllText(Destination, text);
      ]]></Code>
    </Task>
  </UsingTask>

  <Target Name="ThunderstorePackage" AfterTargets="Build" Condition="'$(Configuration)' == 'Release'">
    <ItemGroup>
      <PackageTranslations Include="$(OutDir)Translations/*.txt" />
      <ManifestLines Include="{" />
      <ManifestLines Include="  &quot;name&quot;: &quot;$(ThunderstoreName)&quot;," />
      <ManifestLines Include="  &quot;version_number&quot;: &quot;$(Version)&quot;," />
      <ManifestLines Include="  &quot;website_url&quot;: &quot;$(ThunderstoreWebsite)&quot;," />
      <ManifestLines Include="  &quot;description&quot;: &quot;$(ThunderstoreDescription)&quot;," />
      <ManifestLines Include="  &quot;dependencies&quot;: [ &quot;$(ThunderstoreDependency)&quot; ]" />
      <ManifestLines Include="}" />
    </ItemGroup>
    <RemoveDir Directories="$(PackageStaging)" />
    <MakeDir Directories="$(PackageStaging)Translations" />
    <WriteLinesToFile File="$(PackageStaging)manifest.json" Lines="@(ManifestLines)" Overwrite="true" Encoding="us-ascii" /><!-- Thunderstore rejects a UTF-8 BOM; the manifest is plain ASCII -->
    <Copy SourceFiles="$(RepoRoot)thunderstore/icon.png;$(RepoRoot)CHANGELOG.md" DestinationFolder="$(PackageStaging)" />
    <PackageReadme Source="$(RepoRoot)README.md" Destination="$(PackageStaging)README.md" Images="@(ReadmeImage)" />
    <Copy SourceFiles="$(OutDir)AdvancedPlanting.dll;$(OutDir)AdvancedPlanting.Core.dll" DestinationFolder="$(PackageStaging)" />
    <Copy SourceFiles="@(PackageTranslations)" DestinationFolder="$(PackageStaging)Translations" />
    <Delete Files="$(PackageZip)" />
    <ZipDirectory SourceDirectory="$(PackageStaging)" DestinationFile="$(PackageZip)" />
    <Message Importance="high" Text="Thunderstore package: $(PackageZip)" />
  </Target>

  <Target Name="CopyToGameFolder" AfterTargets="Build" Condition="'$(CopyToGame)' == 'true'">
    <MakeDir Directories="$(PluginOutputPath)" />
    <Copy SourceFiles="$(OutDir)AdvancedPlanting.dll;$(OutDir)AdvancedPlanting.Core.dll" DestinationFolder="$(PluginOutputPath)" />
    <ItemGroup>
      <TranslationFiles Include="$(OutDir)Translations/*.txt" />
    </ItemGroup>
    <Copy SourceFiles="@(TranslationFiles)" DestinationFolder="$(PluginOutputPath)/Translations" />
    <Message Importance="high" Text="AdvancedPlanting copied to $(PluginOutputPath)" />
  </Target>

</Project>
