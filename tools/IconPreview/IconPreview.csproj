<Project Sdk="Microsoft.NET.Sdk">

  <!-- Renders the wheel icons to raw RGBA files using the same IconArt code the mod uses. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../../src/AdvancedPlanting/UI/IconArt.cs" Link="IconArt.cs" />
  </ItemGroup>

</Project>
