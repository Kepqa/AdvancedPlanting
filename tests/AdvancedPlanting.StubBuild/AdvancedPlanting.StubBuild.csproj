<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Compile-only check of the plugin sources against hand-written stubs of the Unity, BepInEx,
    Harmony and Valheim APIs the mod touches. It catches our own type errors without the game
    installed. It does NOT prove the stubs match the real game: the real build against
    assembly_valheim.dll is the authority.
  -->

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <NoWarn>$(NoWarn);CS0649;CS0067;CS0414;CS0169</NoWarn>
    <AssemblyName>AdvancedPlanting.StubBuild</AssemblyName>
    <RootNamespace>AdvancedPlanting</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../../src/AdvancedPlanting/**/*.cs" />
    <Compile Include="Stubs/**/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/AdvancedPlanting.Core/AdvancedPlanting.Core.csproj" />
  </ItemGroup>

</Project>
